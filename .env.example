# Copy to .env.local (never commit that file)
# Base URL of the document-reading backend. Defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000
# Set to true to log extracted personal data in dev builds only
VITE_DEBUG_EXTRACTION=false

# Backend-driven document mismatch flow (needs the Onboarding Accelerator API)
VITE_MISMATCH_FLOW=false
VITE_ONBOARDING_API_URL=http://localhost:8000
